# Preferred for this paper-only app: read-only and valid for one year.
# Generate it in Upstox Developer Apps -> Analytics. Never commit the real token.
UPSTOX_ANALYTICS_TOKEN=
# Optional fallback: standard OAuth token, which expires daily at 03:30 IST.
UPSTOX_ACCESS_TOKEN=
UPSTOX_STREAM_AUTO_START=false
UPSTOX_STREAM_INSTRUMENTS=
UPSTOX_STREAM_MODE=full

# Launch the configured paper runs automatically on NSE trading days.
SCHEDULER_ENABLED=false

# US paper trading. Use paper-account keys from Alpaca; the code hard-locks
# order submission to https://paper-api.alpaca.markets.
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_SECRET_KEY=
# Free accounts normally use IEX; set sip only when the account has that plan.
ALPACA_DATA_FEED=iex
US_SCHEDULER_ENABLED=false
US_SCHEDULER_ENTRY_MODE=MACD_FRESH_CONFIRMED
US_SCHEDULER_MAX_POSITIONS=2
US_SCHEDULER_ALLOCATION=2500
US_SCHEDULER_CANDIDATE_LIMIT=10
US_SCHEDULER_MINIMUM_RELATIVE_VOLUME=1.2

PAPER_INITIAL_CASH=1000000
PAPER_SLIPPAGE_BPS=2
PAPER_DB_PATH=data/paper_trading.db
PAPER_ALLOW_SHORT=false
PAPER_MAX_ORDER_NOTIONAL=250000
PAPER_MAX_POSITION_NOTIONAL=500000
PAPER_MAX_DAILY_LOSS=25000

# NSE cash-equity / Upstox charge assumptions (verified 2026-08-25).
# Keep configurable because broker, exchange, and statutory schedules change.
PAPER_DELIVERY_BROKERAGE_FLAT=20
PAPER_INTRADAY_BROKERAGE_BPS=10
PAPER_INTRADAY_BROKERAGE_CAP=20
PAPER_NSE_TRANSACTION_BPS=0.307
PAPER_SEBI_BPS=0.01
PAPER_DELIVERY_STT_BPS=10
PAPER_INTRADAY_SELL_STT_BPS=2.5
PAPER_DELIVERY_BUY_STAMP_BPS=1.5
PAPER_INTRADAY_BUY_STAMP_BPS=0.3
PAPER_GST_PERCENT=18
PAPER_DELIVERY_SELL_DP_FLAT=20
