# Read-only Upstox Analytics Token. Never commit the real token.
UPSTOX_ACCESS_TOKEN=

PAPER_INITIAL_CASH=1000000
PAPER_SLIPPAGE_BPS=2
PAPER_DB_PATH=data/paper_trading.db
PAPER_ALLOW_SHORT=false
PAPER_MAX_ORDER_NOTIONAL=250000
PAPER_MAX_POSITION_NOTIONAL=500000
PAPER_MAX_DAILY_LOSS=25000

# Charges are configurable because exchange and broker schedules change.
PAPER_BROKERAGE_BPS=0
PAPER_TRANSACTION_BPS=0
PAPER_TAX_BPS=0

